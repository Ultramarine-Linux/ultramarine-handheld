[Unit]
Description=Thaw Marina graphical workloads
PartOf=marina-active.target
Before=marina-active.target
Conflicts=marina-graphical-idle.service
Wants=user@1000.service
Wants=graphical.slice
After=user@1000.service graphical.slice

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/marina-graphical-state active
RemainAfterExit=yes
