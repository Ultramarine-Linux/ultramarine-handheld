set dotenv-load := false

profile := "tg5050"
profile_dir := justfile_directory()
project := profile_dir / "../.."
build_dir := project / "build"
env_source := profile_dir / "board/trimui-linux-direct-root.env"
env_image := build_dir / "env.img"
env_file := build_dir / "uboot.env"
env_partition_image := build_dir / "env-partition.img"

# Build the board's 128 KiB U-Boot environment image.
env:
    mkdir -p {{build_dir}}
    mkenvimage -s 0x20000 -p 0x00 -o {{env_image}} {{env_source}}
    mkenvimage -s 0x20000 -p 0x00 -o {{env_file}} {{env_source}}
    test "$(stat -c %s {{env_image}})" -eq 131072
    test "$(stat -c %s {{env_file}})" -eq 131072
    sha256sum {{env_image}} {{env_file}}

# The environment is now an optional file on the p1 ESP; no environment
# partition is generated for the three-partition mainline layout.

# Build the complete GPT image, including ESP, /boot, and rootfs, with mkosi/repart.
mainline-disk: env mainline-uboot
    #!/usr/bin/env bash
    set -euo pipefail
    sudo mkosi --directory={{project}} --profile={{profile}},mainline --force
    image='{{build_dir}}/ultramarine-trimui-mainline.raw'
    {{profile_dir}}/image/prune-kernel-modules-initrd "$image"
    spl='{{build_dir}}/mainline-uboot-artifacts/sunxi-spl.bin'
    fit='{{build_dir}}/mainline-uboot-artifacts/u-boot.itb'
    test -f "$spl" -a -f "$fit"
    test "$(stat -c %s "$spl")" -le 131072
    test "$(stat -c %s "$fit")" -le $(((2048 - 512) * 512))
    sudo dd if="$spl" of="$image" bs=512 seek=256 conv=notrunc,fsync status=progress
    sudo dd if="$fit" of="$image" bs=512 seek=512 conv=notrunc,fsync status=progress
    spl_size=$(stat -c %s "$spl")
    fit_size=$(stat -c %s "$fit")
    sudo dd if="$image" bs=512 skip=256 count=$(((spl_size + 511) / 512)) status=none | cmp -n "$spl_size" - "$spl"
    sudo dd if="$image" bs=512 skip=512 count=$(((fit_size + 511) / 512)) status=none | cmp -n "$fit_size" - "$fit"
    sudo sgdisk -e "$image"
    sudo sgdisk -v "$image"

rootfs: mainline-disk

# Reproduce the untouched TG5050 Android boot-image v0 p3 carrier.
bootimg:
    {{profile_dir}}/board/android_image/build-p3 --original-ramdisk

# Extract packaged mainline SPL + U-Boot FIT for raw-sector flashing.
mainline-uboot:
    {{profile_dir}}/image/stage-uboot-rpm {{quote(build_dir / "anda-rpms")}} {{quote(build_dir / "mainline-uboot-artifacts")}}

systemd-initrd:
    mkosi --directory={{profile_dir}}/systemd-initrd --force build

mainline-initramfs:
    {{profile_dir}}/board/mainline-initramfs/build

mainline-image: mainline-disk
    {{profile_dir}}/image/assemble-mainline-image


# Incrementally flash mainline SPL/FIT and the p1 boot payload. This leaves
# the GPT, environment, and rootfs untouched. Example: just flash-mainline /dev/sdX
flash-mainline target:
    #!/usr/bin/env bash
    set -euo pipefail
    set -x
    target={{quote(target)}}
    bootdev=$({{profile_dir}}/image/validate-target "$target")
    spl='{{build_dir}}/mainline-uboot-artifacts/sunxi-spl.bin'
    fit='{{build_dir}}/mainline-uboot-artifacts/u-boot.itb'
    test -f "$spl" -a -f "$fit"
    test "$(stat -c %s "$spl")" -le 131072 || { echo "SPL overlaps FIT slot" >&2; exit 1; }
    # Raw FIT slot is LBA 512 through the sector before p1 at LBA 2048.
    test "$(stat -c %s "$fit")" -le $(((2048 - 512) * 512)) || {
        echo "FIT overlaps p1/GPT layout" >&2; exit 1;
    }
    mountpoint=$(mktemp -d)
    cleanup() { sudo umount "$mountpoint" 2>/dev/null || true; sudo rmdir "$mountpoint" 2>/dev/null || true; }
    trap cleanup EXIT
    sudo mount -o ro "${bootdev}1" "$mountpoint"
    test -f "$mountpoint/EFI/BOOT/BOOTAA64.EFI" || {
        echo "p1 lacks systemd-boot EFI loader" >&2; exit 1;
    }
    test -f "$mountpoint/loader/loader.conf" || {
        echo "p1 lacks systemd-boot loader.conf" >&2; exit 1;
    }
    sync
    sudo umount "$mountpoint"
    sudo dd if="$spl" of="$target" bs=512 seek=256 conv=notrunc,fsync status=progress
    sudo dd if="$fit" of="$target" bs=512 seek=512 conv=notrunc,fsync status=progress
    spl_size=$(stat -c %s "$spl")
    fit_size=$(stat -c %s "$fit")
    sudo dd if="$target" bs=512 skip=256 count=$(((spl_size + 511) / 512)) status=none | cmp -n "$spl_size" - "$spl"
    sudo dd if="$target" bs=512 skip=512 count=$(((fit_size + 511) / 512)) status=none | cmp -n "$fit_size" - "$fit"
    echo "incremental mainline flash verified: $target"

# Replace only the ESP filesystem from the generated image. This fixes ESP
# filesystem geometry without touching raw SPL/FIT, p2, p3, or the GPT.
# Example: just flash-esp /dev/sdX
flash-esp target:
    #!/usr/bin/env bash
    set -euo pipefail
    target={{quote(target)}}
    bootdev=$({{profile_dir}}/image/validate-target "$target")
    image='{{build_dir}}/ultramarine-trimui-mainline.raw'
    test -f "$image"
    loop=$(sudo losetup --find --show --read-only --partscan "$image")
    cleanup() { sudo losetup -d "$loop" 2>/dev/null || true; }
    trap cleanup EXIT
    source="${loop}p1"
    target_esp="${bootdev}1"
    source_size=$(sudo blockdev --getsize64 "$source")
    target_size=$(sudo blockdev --getsize64 "$target_esp")
    test "$source_size" = "$target_size" || {
        echo "p1 size mismatch: source=$source_size target=$target_size" >&2
        exit 1
    }
    sudo fsck.fat -vn "$source"
    sudo dd if="$source" of="$target_esp" bs=16M iflag=fullblock conv=fsync status=progress
    sudo blockdev --flushbufs "$target"
    sudo cmp "$source" "$target_esp"
    sudo fsck.fat -vn "$target_esp"
    echo "ESP p1 flash verified: $target_esp"

# Replace only p2 (/boot), including the mainline kernel and BSP fallback.
# Preserve the existing GPT, raw SPL/FIT, ESP, and rootfs.
flash-boot target:
    #!/usr/bin/env bash
    set -euo pipefail
    target={{quote(target)}}
    bootdev=$({{profile_dir}}/image/validate-target "$target")
    image='{{build_dir}}/ultramarine-trimui-mainline.raw'
    test -f "$image"
    loop=$(sudo losetup --find --show --read-only --partscan "$image")
    cleanup() { sudo losetup -d "$loop" 2>/dev/null || true; }
    trap cleanup EXIT
    source="${loop}p2"
    target_boot="${bootdev}2"
    source_size=$(sudo blockdev --getsize64 "$source")
    target_size=$(sudo blockdev --getsize64 "$target_boot")
    test "$source_size" = "$target_size" || {
        echo "p2 size mismatch: source=$source_size target=$target_size" >&2
        exit 1
    }
    sudo e2fsck -fn "$source"
    sudo dd if="$source" of="$target_boot" bs=16M iflag=fullblock conv=fsync status=progress
    sudo blockdev --flushbufs "$target"
    sudo cmp "$source" "$target_boot"
    sudo e2fsck -fn "$target_boot"
    echo "boot p2 flash verified: $target_boot"

# Rewrite only p3 from the generated image, preserving GPT and p1-p2.
# Example: just flash-rootfs /dev/sdX
flash-rootfs target:
    #!/usr/bin/env bash
    set -euo pipefail
    target={{quote(target)}}
    part=$({{profile_dir}}/image/validate-target "$target")
    rootdev="${part}3"
    ! findmnt "$rootdev" >/dev/null || {
        echo "root partition is mounted: $rootdev" >&2
        exit 1
    }
    image='{{build_dir}}/ultramarine-trimui-mainline.raw'
    test -f "$image"
    loop=$(sudo losetup --find --show --read-only --partscan "$image")
    cleanup() { sudo losetup -d "$loop" 2>/dev/null || true; }
    trap cleanup EXIT
    source="${loop}p3"
    source_size=$(sudo blockdev --getsize64 "$source")
    target_size=$(sudo blockdev --getsize64 "$rootdev")
    test "$source_size" = "$target_size" || {
        echo "p3 size mismatch: source=$source_size target=$target_size" >&2
        exit 1
    }
    sudo e2fsck -fn "$source"
    sudo dd if="$source" of="$rootdev" bs=16M iflag=fullblock conv=fsync status=progress
    sudo blockdev --flushbufs "$target"
    sudo cmp "$source" "$rootdev"
    sudo e2fsck -fn "$rootdev"
    echo "rootfs p3 flash verified: $rootdev"

# Reproduce the untouched SD reference carrier byte-for-byte.
bootimg-reference:
    {{profile_dir}}/board/android_image/build-p3 --original-ramdisk

# Assemble the complete SD-card image from the selected profile's artifacts.
image: mainline-image

summary:
    mkosi --directory={{project}} --profile={{profile}},mainline summary

# Build the shared TG5050 userspace with the vendor BSP module overlay.
bsp-rootfs-tree:
    sudo mkosi --directory={{project}} --profile={{profile}},bsp --force
