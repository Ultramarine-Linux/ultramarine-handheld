set dotenv-load := false

profile := "tg5050"
profile_dir := justfile_directory()
project := profile_dir / "../.."
build_dir := project / "build"
env_source := profile_dir / "board/trimui-linux-direct-root.env"
env_image := build_dir / "env.img"
env_partition_image := build_dir / "env-partition.img"

# Build the board's 128 KiB U-Boot environment image.
env:
    mkdir -p {{build_dir}}
    mkenvimage -s 0x20000 -p 0x00 -o {{env_image}} {{env_source}}
    test "$(stat -c %s {{env_image}})" -eq 131072
    sha256sum {{env_image}}

# Build the complete 16 MiB p2 partition: active environment at offset zero,
# with the verified all-zero remainder used by the compact SD baseline.

# Internal mkosi staging step. The public rootfs target emits an ext4 image;
# this directory is not a deliverable and is removed after packaging.
rootfs-tree: mainline-modules
    sudo mkosi --directory={{project}} --profile={{profile}} --force

# Build the TG5050 direct p4 ext4 filesystem image with real ownership metadata.
rootfs-image: rootfs-tree
    sudo rm -f {{build_dir}}/ultramarine-rootfs.ext4
    sudo truncate -s 2G {{build_dir}}/ultramarine-rootfs.ext4
    sudo mkfs.ext4 -F -L ULTRAMARINE -d {{build_dir}}/ultramarine-rootfs {{build_dir}}/ultramarine-rootfs.ext4
    sudo e2fsck -fn {{build_dir}}/ultramarine-rootfs.ext4
    sudo rm -rf {{build_dir}}/ultramarine-rootfs

# emit rootfs image
rootfs: rootfs-image

# Reproduce the untouched TG5050 Android boot-image v0 p3 carrier.
bootimg:
    {{profile_dir}}/board/android_image/build-p3 --original-ramdisk

# Build mainline SPL + U-Boot FIT inside the board-owned Fedora 44 sandbox.
mainline-uboot:
    mkosi --directory={{profile_dir}}/board/mainline-uboot --force

# Apply the pinned TG5050 patchset to a Linux v7.2 tree and build Image/modules/DTB.
mainline-kernel:
    {{profile_dir}}/board/mainline-kernel/build

# Stage matching in-tree modules, AIC8800 modules, and firmware for mkosi.
mainline-modules: mainline-kernel
    {{profile_dir}}/board/mainline-kernel/stage-modules {{quote(build_dir / "mainline-kernel-worktree")}}

systemd-initrd:
    mkosi --directory={{profile_dir}}/systemd-initrd --force build

mainline-initramfs:
    {{profile_dir}}/board/mainline-initramfs/build

mainline-image: image mainline-uboot mainline-initramfs systemd-initrd mainline-kernel
    {{profile_dir}}/image/assemble-mainline-image

# Incrementally flash mainline SPL/FIT and the p1 boot payload. This leaves
# the GPT, environment, and rootfs untouched. Example: just flash-mainline /dev/sdX
flash-mainline target:
    #!/usr/bin/env bash
    set -euo pipefail
    set -x
    target={{quote(target)}}
    bootdev=$({{profile_dir}}/image/validate-target "$target")
    spl='{{build_dir}}/mainline-uboot-artifacts/sunxi-spl.bin'
    fit='{{build_dir}}/mainline-uboot-artifacts/u-boot.itb'
    kernel='{{build_dir}}/mainline-src/linux/arch/arm64/boot/Image'
    ramdisk='{{build_dir}}/mainline-initramfs.cpio.gz'
    systemd_ramdisk='{{build_dir}}/mainline-systemd-initramfs.cpio.gz'
    dtb='{{build_dir}}/mainline-src/linux/arch/arm64/boot/dts/allwinner/sun55i-a523-trimui-smart-pro-s.dtb'
    extlinux='{{profile_dir}}/image/extlinux-mainline.conf'
    test -f "$spl" -a -f "$fit" -a -f "$kernel" -a -f "$ramdisk" -a -f "$systemd_ramdisk" -a -f "$dtb" -a -f "$extlinux"
    test "$(stat -c %s "$spl")" -le 131072 || { echo "SPL overlaps FIT slot" >&2; exit 1; }
    test "$(stat -c %s "$fit")" -le 37486592 || { echo "FIT overlaps GPT/partitions" >&2; exit 1; }
    mountpoint=$(mktemp -d)
    cleanup() { sudo umount "$mountpoint" 2>/dev/null || true; sudo rmdir "$mountpoint" 2>/dev/null || true; }
    trap cleanup EXIT
    sudo mount "${bootdev}1" "$mountpoint"
    test "$(df --output=avail -B1 "$mountpoint" | tail -n 1)" -ge $((
        $(stat -c %s "$kernel") + $(stat -c %s "$ramdisk") +
        $(stat -c %s "$systemd_ramdisk") + $(stat -c %s "$dtb") +
        $(stat -c %s "$extlinux")
    )) || { echo "insufficient free space on ${bootdev}1" >&2; exit 1; }
    sudo install -m 0644 "$kernel" "$mountpoint/Image"
    sudo install -m 0644 "$ramdisk" "$mountpoint/initramfs.cpio.gz"
    sudo install -m 0644 "$systemd_ramdisk" "$mountpoint/initramfs-systemd.cpio.gz"
    sudo install -m 0644 "$dtb" "$mountpoint/sun55iw3p1-soc-system.dtb"
    sudo mkdir -p "$mountpoint/extlinux"
    sudo install -m 0644 "$extlinux" "$mountpoint/extlinux/extlinux.conf"
    sync
    sudo umount "$mountpoint"
    sudo dd if="$spl" of="$target" bs=512 seek=256 conv=notrunc,fsync status=progress
    sudo dd if="$fit" of="$target" bs=512 seek=512 conv=notrunc,fsync status=progress
    spl_size=$(stat -c %s "$spl")
    fit_size=$(stat -c %s "$fit")
    sudo dd if="$target" bs=512 skip=256 count=$(((spl_size + 511) / 512)) status=none | cmp -n "$spl_size" - "$spl"
    sudo dd if="$target" bs=512 skip=512 count=$(((fit_size + 511) / 512)) status=none | cmp -n "$fit_size" - "$fit"
    sudo mount -o ro "${bootdev}1" "$mountpoint"
    cmp "$kernel" "$mountpoint/Image"
    cmp "$ramdisk" "$mountpoint/initramfs.cpio.gz"
    cmp "$systemd_ramdisk" "$mountpoint/initramfs-systemd.cpio.gz"
    cmp "$dtb" "$mountpoint/sun55iw3p1-soc-system.dtb"
    cmp "$extlinux" "$mountpoint/extlinux/extlinux.conf"
    sudo umount "$mountpoint"
    echo "incremental mainline flash verified: $target"

# Rewrite only p4 from the generated image, preserving GPT and p1-p3.
# Example: just flash-rootfs /dev/sdX
flash-rootfs target:
    #!/usr/bin/env bash
    set -euo pipefail
    target={{quote(target)}}
    part=$({{profile_dir}}/image/validate-target "$target")
    rootdev="${part}4"
    ! findmnt "$rootdev" >/dev/null || {
        echo "root partition is mounted: $rootdev" >&2
        exit 1
    }
    image='{{build_dir}}/ultramarine-trimui-6g.raw'
    test -f "$image"
    loop=$(sudo losetup --find --show --read-only --partscan "$image")
    cleanup() { sudo losetup -d "$loop" 2>/dev/null || true; }
    trap cleanup EXIT
    source="${loop}p4"
    source_size=$(sudo blockdev --getsize64 "$source")
    target_size=$(sudo blockdev --getsize64 "$rootdev")
    test "$source_size" = "$target_size" || {
        echo "p4 size mismatch: source=$source_size target=$target_size" >&2
        exit 1
    }
    sudo e2fsck -fn "$source"
    sudo dd if="$source" of="$rootdev" bs=16M iflag=fullblock conv=fsync status=progress
    sudo blockdev --flushbufs "$target"
    sudo cmp "$source" "$rootdev"
    sudo e2fsck -fn "$rootdev"
    echo "rootfs p4 flash verified: $rootdev"

# Reproduce the untouched SD reference carrier byte-for-byte.
bootimg-reference:
    {{profile_dir}}/board/android_image/build-p3 --original-ramdisk

# Assemble the complete SD-card image from the selected profile's artifacts.
image: env bootimg rootfs-image
    {{profile_dir}}/image/assemble-sd-image

summary:
    mkosi --directory={{project}} --profile={{profile}} summary
