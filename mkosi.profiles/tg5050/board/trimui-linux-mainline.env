# Mainline U-Boot environment for the TG5050 EFI/systemd-boot path.
# The imported environment replaces compiled defaults, so do not reference
# distro_bootcmd unless the complete generated distro environment is present.
bootdelay=0
kernel_addr_r=0x40000000
bootcmd=load mmc 0:1 ${kernel_addr_r} EFI/BOOT/BOOTAA64.EFI;bootefi ${kernel_addr_r} ${fdtcontroladdr}
