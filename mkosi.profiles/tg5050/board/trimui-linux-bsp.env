earlycon=uart8250,mmio32,0x02500000
console=ttyAS0,115200
mmc_root=/dev/mmcblk0p3
init=/sbin/init
loadaddr=0x40000000
kernel_addr_r=0x40000000
fdt_addr_r=0x48000000
ramdisk_addr_r=0x50000000
setargs_bsp=setenv bootargs earlycon=uart8250,mmio32,0x02500000 console=ttyAS0,115200 root=${mmc_root} rootwait rw init=/sbin/init loglevel=7 panic=10 maxcpus=1
load_bsp=load mmc 0:2 ${kernel_addr_r} vmlinuz-5.15.147;load mmc 0:3 ${fdt_addr_r} usr/lib/tg5050/bsp/sun55i-a523-trimui-smart-pro-s.dtb
boot_bsp=run setargs_bsp load_bsp;booti ${kernel_addr_r} - ${fdt_addr_r}
bootcmd=run boot_bsp