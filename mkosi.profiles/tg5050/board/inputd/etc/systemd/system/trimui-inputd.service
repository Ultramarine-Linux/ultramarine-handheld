[Unit]
Description=TrimUI Smart Pro S integrated gamepad input daemon
After=dev-ttyAS5.device dev-ttyAS7.device systemd-udev-settle.service
Wants=dev-ttyAS5.device dev-ttyAS7.device
Before=graphical.target

[Service]
Type=forking
ExecStart=/usr/local/libexec/trimui_inputd
Restart=on-failure
RestartSec=1
DeviceAllow=/dev/ttyAS5 rw
DeviceAllow=/dev/ttyAS7 rw
DeviceAllow=/dev/uinput rw

[Install]
WantedBy=multi-user.target
