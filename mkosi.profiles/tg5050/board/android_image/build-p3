#!/usr/bin/env bash
# Rebuild the SD-proven Android boot-image v0 carrier used by p3.
#
# Default mode consumes the original ramdisk blob and must reproduce the
# reference image byte-for-byte. --repack-root packages root/ as a fresh
# gzip-cpio ramdisk for deliberate /init changes, while retaining the vendor
# kernel and Android v0 header contract.
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
project=$(cd -- "$script_dir/../../../.." && pwd)
build="$project/build"
reference="$script_dir/../vendor/sd/p3-kernel-container.img"
kernel="$script_dir/kernel"
original_ramdisk="$script_dir/ramdisk.cpio.gz"
root="$script_dir/root"
output="$build/ultramarine-p3.img"
mode="${1:---original-ramdisk}"

case "$mode" in
    --original-ramdisk|--repack-root) ;;
    *)
        echo "usage: $0 [--original-ramdisk|--repack-root]" >&2
        exit 2
        ;;
esac

for input in "$reference" "$kernel" "$original_ramdisk" "$root/init"; do
    test -f "$input" || { echo "missing required input: $input" >&2; exit 1; }
done

stage=$(mktemp -d)
cleanup() {
    rm -rf "$stage"
}
trap cleanup EXIT

ramdisk="$original_ramdisk"
if test "$mode" = --repack-root; then
    ramdisk="$stage/ramdisk.cpio.gz"
    # Keep archive ordering deterministic and make the early root genuinely
    # root-owned even when this recipe runs unprivileged.
    (
        cd "$root"
        python3 - <<'PY' | cpio --null -o -H newc --owner=0:0 --quiet | gzip -n > "$ramdisk"
import os
for base, dirs, files in os.walk('.', topdown=True, followlinks=False):
    dirs.sort()
    files.sort()
    print(base, end='\0')
    for name in files:
        print(os.path.join(base, name), end='\0')
PY
    )
fi

mkbootimg \
    --kernel "$kernel" \
    --ramdisk "$ramdisk" \
    --header_version 0 \
    --pagesize 2048 \
    --base 0x40000000 \
    --kernel_offset 0x00080000 \
    --ramdisk_offset 0x02000000 \
    --second_offset 0x00f00000 \
    --tags_offset 0x00000100 \
    --board sun55i_arm64 \
    --output "$stage/boot.img"

# mkbootimg zeroes second_addr when second_size=0. The reference v0 carrier
# keeps this inert field at 0x40f00000; restore it for binary compatibility.
python3 - "$stage/boot.img" <<'PY'
import struct
import sys
with open(sys.argv[1], 'r+b') as image:
    image.seek(28)  # Android boot-image v0 second_addr
    image.write(struct.pack('<I', 0x40f00000))
PY

mkdir -p "$build"
truncate -s 96M "$output"
dd if="$stage/boot.img" of="$output" conv=notrunc status=none

# Read back the produced container, not just the mkbootimg exit code.
unpack_bootimg --boot_img "$output" --out "$stage/unpacked" >/dev/null
cmp -s "$kernel" "$stage/unpacked/kernel"
cmp -s "$ramdisk" "$stage/unpacked/ramdisk"

if test "$mode" = --original-ramdisk; then
    cmp -s "$output" "$reference"
    echo "p3 reproduced byte-for-byte: $output"
else
    echo "p3 rebuilt from editable root: $output"
fi

sha256sum "$output"
