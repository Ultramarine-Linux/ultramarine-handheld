# Stock TrimUI p2 environment, with only the root selection changed for the
# first experiment: p3's vendor boot image mounts p4 and executes systemd.
earlycon=uart8250,mmio32,0x02500000
initcall_debug=0
console=ttyAS0,115200
mmc_root=/dev/mmcblk0p4
init=/sbin/init
boot_partition=boot
root_partition=rootfs
loglevel=0
cma=128M
keybox_list=hdcpkey,widevine
partitions=boot-resource@mmcblk0p1:env@mmcblk0p2:boot@mmcblk0p3:ramdisk@mmcblk0p4:rootfs@mmcblk0p5
setargs_mmc=setenv  bootargs earlycon=uart8250,mmio32,0x02500000 clk_ignore_unused initcall_debug=${initcall_debug} console=ttyS0 console=${console} loglevel=${loglevel} cma=${cma} root=${mmc_root} init=${init} partitions=${partitions} gpt=1 pd_ignore_unused=1 slub_debug=UFPZ
boot_normal=sunxi_flash read 44000000 boot;bootm 44000000
bootdelay=0
bootcmd=run setargs_mmc boot_normal
