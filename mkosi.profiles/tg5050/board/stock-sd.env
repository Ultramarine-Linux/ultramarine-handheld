# Live stock p2 environment with only SD boot selection adapted for the p4
# direct-systemd experiment: use mmc arguments and start p4:/sbin/init.
earlycon=uart8250,mmio32,0x02500000
initcall_debug=0
console=ttyAS0,115200
nand_root=/dev/nand0p4
mmc_root=/dev/mmcblk0p4
nor_root=/dev/mtdblock4
init=/sbin/init
boot_partition=boot
root_partition=rootfs
loglevel=0
selinux=0
cma=128M
mac=
wifi_mac=
bt_mac=
specialstr=
riscv_partition=riscv
keybox_list=hdcpkey,widevine
setargs_nor=setenv bootargs  earlycon=${earlycon} clk_ignore_unused initcall_debug=${initcall_debug} console=${console} loglevel=${loglevel} root=${nor_root} init=${init} partitions=${partitions} cma=${cma} snum=${snum} mac_addr=${mac} wifi_mac=${wifi_mac} bt_mac=${bt_mac} selinux=${selinux} specialstr=${specialstr} gpt=1 pd_ignore_unused=1
setargs_nand=setenv bootargs earlycon=${earlycon} clk_ignore_unused initcall_debug=${initcall_debug} console=${console} loglevel=${loglevel} root=${nand_root} init=${init} partitions=${partitions} cma=${cma} snum=${snum} mac_addr=${mac} wifi_mac=${wifi_mac} bt_mac=${bt_mac} selinux=${selinux} specialstr=${specialstr} gpt=1 pd_ignore_unused=1
setargs_mmc=setenv  bootargs earlycon=${earlycon} clk_ignore_unused initcall_debug=${initcall_debug} console=${console} loglevel=${loglevel} root=${mmc_root}  init=${init} partitions=${partitions} cma=${cma} snum=${snum} mac_addr=${mac} wifi_mac=${wifi_mac} bt_mac=${bt_mac} selinux=${selinux} specialstr=${specialstr} gpt=1 pd_ignore_unused=1 slub_debug=UFPZ
boot_riscv=sunxi_flash read 44000000 ${riscv_partition};bootrv 44000000 0 0
boot_normal=sunxi_flash read 44000000 ${boot_partition};bootm 44000000
boot_recovery=sunxi_flash read 44000000 recovery;bootm 44000000
boot_fastboot=fastboot
recovery_key_value_max=0x13
recovery_key_value_min=0x10
fastboot_key_value_max=0x8
fastboot_key_value_min=0x2
bootdelay=0
bootcmd=run setargs_mmc boot_normal
