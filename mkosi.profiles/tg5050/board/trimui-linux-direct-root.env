earlycon=uart8250,mmio32,0x02500000
console=ttyAS0,115200
mmc_root=/dev/mmcblk0p4
init=/init
ramdisk_addr_r=0x50000000
boot_partition=boot
root_partition=rootfs
partitions=boot-resource@mmcblk0p1:env@mmcblk0p2:boot@mmcblk0p3:rootfs@mmcblk0p4
setargs_mmc=setenv bootargs earlycon=${earlycon} clk_ignore_unused console=${console} loglevel=7 root=${mmc_root} init=${init} partitions=${partitions} gpt=1 pd_ignore_unused=1
load_initrd=load mmc 0:1 ${ramdisk_addr_r} initrd;setenv ramdisk_size ${filesize}
boot_normal=run load_initrd;sunxi_flash read 44000000 ${boot_partition};bootm 44000000 ${ramdisk_addr_r}:${ramdisk_size}
bootcmd=run setargs_mmc boot_normal
