#!/bin/bash
set -euo pipefail

# The handheld has no practical interactive first-boot account setup. Create
# the account used by the Sway appliance session while the image is being assembled.
for group in video render input audio; do
    getent group "$group" >/dev/null || groupadd --system "$group"
done
if ! id ultramarine >/dev/null 2>&1; then
    useradd --create-home --uid 1000 --user-group \
        --groups video,render,input,audio,wheel ultramarine
fi
usermod --append --groups video,render,input,audio,wheel ultramarine
install -d -o ultramarine -g ultramarine -m 0700 /home/ultramarine
cp -a /etc/skel/. /home/ultramarine/
chown ultramarine:ultramarine /home/ultramarine/.bashrc /home/ultramarine/.bash_profile
chmod 0644 /home/ultramarine/.bashrc /home/ultramarine/.bash_profile
install -d -o ultramarine -g ultramarine -m 0755 /home/ultramarine/.config/zellij
chown ultramarine:ultramarine /home/ultramarine/.config/zellij/config.kdl
chmod 0644 /home/ultramarine/.config/zellij/config.kdl
install -d -o ultramarine -g ultramarine -m 0755 /home/ultramarine/.config/sway
chown -R ultramarine:ultramarine /home/ultramarine/.config/sway
chmod 0644 /home/ultramarine/.config/sway/config

# ES-DE does not include this SDL mapping for the trimui_inputd virtual pad.
install -d -o ultramarine -g ultramarine -m 0755 /home/ultramarine/ES-DE/controllers
cat > /home/ultramarine/ES-DE/controllers/es_controller_mappings.cfg <<'EOF'
# Knulli-compatible TrimUI Smart Pro S virtual controller.
030000005e0400008e02000014010000,TRIMUI Smart Pro S Controller,platform:Linux,b:b1,a:b0,dpdown:h0.4,leftx:a0,lefty:a1,rightx:a2,righty:a3,lefttrigger:b6,leftstick:b11,dpleft:h0.8,rightshoulder:b5,leftshoulder:b4,righttrigger:b7,rightstick:b12,dpright:h0.2,back:b8,start:b9,dpup:h0.1,y:b3,x:b2,guide:b10,
EOF
chown ultramarine:ultramarine /home/ultramarine/ES-DE/controllers/es_controller_mappings.cfg
chmod 0644 /home/ultramarine/ES-DE/controllers/es_controller_mappings.cfg

# The vendor display engine rejects AFBC-compressed KWin buffers.  Keep
# Bigscreen on linear GBM buffers, as used by the validated Panfrost scanout
# path.
install -d -o ultramarine -g ultramarine -m 0755 \
    /home/ultramarine/.config/plasma-workspace/env
cat > /home/ultramarine/.config/plasma-workspace/env/kwin-drm.sh <<'EOF'
#!/bin/sh
export KWIN_DRM_USE_MODIFIERS=0
EOF
chown ultramarine:ultramarine \
    /home/ultramarine/.config/plasma-workspace/env/kwin-drm.sh
chmod 0755 /home/ultramarine/.config/plasma-workspace/env/kwin-drm.sh

# SSH StrictModes requires root-owned key material even when the overlay was
# staged by an unprivileged build user.
chown root:root /root
chmod 0700 /root
install -d -o root -g root -m 0700 /root/.ssh
chown root:root /root/.ssh/authorized_keys
chmod 0600 /root/.ssh/authorized_keys
chmod 0644 /etc/ssh/sshd_config.d/10-trimui-rescue.conf

# NetworkManager refuses system keyfiles that retain the build user's ownership.
chown root:root /etc/NetworkManager/system-connections/*.nmconnection
chmod 0600 /etc/NetworkManager/system-connections/*.nmconnection
