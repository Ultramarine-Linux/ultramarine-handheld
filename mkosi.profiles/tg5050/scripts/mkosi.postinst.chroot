#!/bin/bash
set -euo pipefail

# Board-specific account setup. The generic appliance user comes from the
# base profile; this only handles TG5050 display and key material quirks.

# The vendor display engine rejects AFBC-compressed KWin buffers.  Keep
# Bigscreen on linear GBM buffers, as used by the validated Panfrost scanout
# path.
install -d -o ultramarine -g ultramarine -m 0755 \
    /var/games/home/.config/plasma-workspace/env
cat > /var/games/home/.config/plasma-workspace/env/kwin-drm.sh <<'EOF'
#!/bin/sh
export KWIN_DRM_USE_MODIFIERS=0
EOF
chown ultramarine:ultramarine \
    /var/games/home/.config/plasma-workspace/env/kwin-drm.sh
chmod 0755 /var/games/home/.config/plasma-workspace/env/kwin-drm.sh

# SSH StrictModes requires root-owned key material even when the overlay was
# staged by an unprivileged build user.
chown root:root /root/.ssh/authorized_keys
chmod 0600 /root/.ssh/authorized_keys
chmod 0644 /etc/ssh/sshd_config.d/10-trimui-rescue.conf

# Drop every stock TuneD profile: the appliance only uses its own five
# (balanced, balanced-battery, marina-minimal, powersave,
# throughput-performance) from /etc/tuned/profiles, which shadow these paths
# anyway. Our balanced-battery includes our own balanced, so no stock parent
# is needed. This also re-applies on rebuilds when tuned updates restore them.
rm -rf /usr/lib/tuned/profiles
