#!/usr/bin/env bash
set -euo pipefail

# The initrd root is the raw ext4 early userspace launched by the vendor kernel.
stage=$(mktemp -d)
cleanup() {
    rm -rf "$stage"
}
trap cleanup EXIT

# Static AArch64 BusyBox keeps this bootstrap independent of a dynamic runtime.
install -D -m 0755 "$BUILDROOT/usr/bin/busybox" "$stage/bin/busybox"
for applet in ash cat mkdir mount sleep switch_root sync; do
    ln -s busybox "$stage/bin/$applet"
done
install -m 0755 "$SRCDIR/root/init" "$stage/init"
mkdir -p "$stage"/{dev,proc,sys,sysroot,sbin}
# The vendor kernel normally honors init=/init, but provide the conventional
# fallback names as the same bootstrap while p4 PID-1 selection is traced.
ln -s init "$stage/linuxrc"
ln -s ../init "$stage/sbin/init"
chown -hR 0:0 "$stage"

# The 512 MiB p4 partition is an ordinary Linux ext4 root. Retain the
# conservative feature set that matched the original vendor p4 filesystem.
truncate -s 512M "$DESTDIR/initrd-root.ext4"
mkfs.ext4 -F -L RAMDISK -b 4096 -N 8192 \
    -O ^orphan_file,^metadata_csum_seed \
    -U afa24c06-855c-4edb-a6db-a0dc4ed61e2e \
    -d "$stage" "$DESTDIR/initrd-root.ext4" >/dev/null
e2fsck -fn "$DESTDIR/initrd-root.ext4"
