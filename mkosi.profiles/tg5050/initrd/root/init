#!/bin/ash
# Raw ext4 p4 bootstrap, launched by p3 when p2 selects root=p4 init=/init.
set -u

LOG=/p4-boot.log
: > "$LOG" 2>/dev/null || true

log() {
    printf '[p4] %s\n' "$*" >>"$LOG" 2>/dev/null || true
}

log 'init started'
log "cmdline: $(cat /proc/cmdline 2>/dev/null || printf unavailable)"

mount -t devtmpfs devtmpfs /dev
log 'mounted devtmpfs'
mount -t proc proc /proc
log 'mounted proc'
mount -t sysfs sysfs /sys
log 'mounted sysfs'

log 'mounting Ultramarine root on /dev/mmcblk0p5'
mkdir -p /sysroot
if ! mount -t ext4 -o rw /dev/mmcblk0p5 /sysroot; then
    log 'cannot mount /dev/mmcblk0p5'
    exec /bin/ash
fi
log 'mounted p5'

mkdir -p /sysroot/dev /sysroot/proc /sysroot/sys
mount --move /dev /sysroot/dev
log 'moved /dev'
mount --move /proc /sysroot/proc
log 'moved /proc'
mount --move /sys /sysroot/sys
log 'moved /sys'
log 'switching to p5 /sbin/init'
exec switch_root /sysroot /sbin/init
