[Unit]
Description=Marina graphical Sway session
After=graphical-session-pre.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStartPre=/usr/bin/systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY SWAYSOCK
ExecStart=/usr/bin/sway
ExecStartPost=/usr/bin/systemctl --user set-environment WAYLAND_DISPLAY=wayland-1
ExecStartPost=/usr/bin/systemctl --user start sway-session.target
Restart=on-failure
RestartSec=1
MemoryHigh=192M
MemoryMax=384M
CPUWeight=50
IOWeight=50
OOMScoreAdjust=300
