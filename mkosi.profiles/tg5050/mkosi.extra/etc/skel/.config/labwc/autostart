#!/bin/sh

# Native portrait mode for the Smart Pro S panel.
wlr-randr --output DSI-1 --mode 720x1280@59.517Hz --transform 90 || true

# Invoke labwc's cursor-hide binding for controller-only sessions.
wtype -M alt -M logo -P h

# Import LabWC's Wayland session into the systemd user manager, then let the
# user service own the remote Foot/Zellij console lifecycle.
systemctl --user import-environment \
    WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
    XDG_SESSION_TYPE XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS || true
systemctl --user daemon-reload
systemctl --user restart marina-remote-console.service
