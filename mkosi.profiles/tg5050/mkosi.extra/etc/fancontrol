# TG5050 pwm-fan configuration for the vendor kernel.
# The pwmfan hwmon device is registered after the fixed USB/battery hwmon
# devices on this board and is hwmon8 on the current release-8 boot.
INTERVAL=2
FCTEMPS=/sys/class/hwmon/hwmon8/pwm1=/sys/class/thermal/thermal_zone1/temp
FCFANS=
MINTEMP=/sys/class/hwmon/hwmon8/pwm1=35
MAXTEMP=/sys/class/hwmon/hwmon8/pwm1=60
MINSTART=/sys/class/hwmon/hwmon8/pwm1=100
MINSTOP=/sys/class/hwmon/hwmon8/pwm1=100
MINPWM=/sys/class/hwmon/hwmon8/pwm1=1
MAXPWM=/sys/class/hwmon/hwmon8/pwm1=255
AVERAGE=/sys/class/hwmon/hwmon8/pwm1=3
