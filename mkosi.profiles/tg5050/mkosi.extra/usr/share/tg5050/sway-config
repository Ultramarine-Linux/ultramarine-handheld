# Canonical TG5050 appliance Sway session (image-managed).
# Seeded to /var/games/home/.config/sway/config on first boot; that user
# copy shadows /etc/sway/config.d entirely, so every appliance setting must
# live here, not in a drop-in. Do not add Home-key handling here: the Home
# key passes through to Marina, which owns it.
# Keep every application in a floating container: there is no tiling UI on
# this handheld, and Sway IPC remains available for future integrations.
# Board-exclusive output wiring (panel mode, rotation) lives in the board
# layer. Import the whole config.d directory so every board's drop-ins and
# the distro session integration apply; this session itself stays board-
# agnostic. Fedora's session.sh owns sway-session.target startup -- the
# bridge below cooperates with it (start is idempotent) instead of tearing
# a just-started session down.
include /etc/sway/config.d/*

default_border pixel 2
default_floating_border none
focus_follows_mouse no
mouse_warping none
for_window [app_id="org.ultramarinelinux.MarinaShell"] border none

# Sway has no bar or decorations in this appliance session. Do not declare a
# bar at all: even `mode invisible` starts a swaybar process.

# Consume the hardware volume rocker in the compositor. Without these
# bindings KEY_VOLUMEUP/DOWN falls through to the focused game as keyboard
# input instead of controlling the default PipeWire sink.
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+

# Native Wayland and Xwayland windows both become floating.
for_window [app_id=".*"] floating enable
for_window [class=".*"] floating enable
for_window [app_id="org.ultramarinelinux.MarinaShell"] floating enable, resize set width 100 ppt height 100 ppt, move position 0 0
for_window [app_id="foot"] fullscreen enable

# Gamepad-driven handheld: hide the pointer after 3s idle. It reappears on
# real pointer movement, so ports mapping sticks to mouse are unaffected.
seat seat0 hide_cursor 3000

# The wallpaper is owned by the swaybg.service user unit. Without this,
# sway auto-spawns a bare swaybg per output (respawned on every reload).
swaybg_command -

# Import Sway's dynamic environment before starting session-bound services.
# The bridge runs inside Sway after its actual Wayland/IPC sockets exist.
exec /usr/libexec/marina-sway-session
