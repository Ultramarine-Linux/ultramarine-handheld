#!/usr/bin/env bash
# Build the proven compact 6 GiB SD baseline in the TG5050 profile layout.
# The early SD payloads are the initial working combination: stock boot0 plus
# the SD-proven boot package and Android p3 container.
set -euo pipefail

profile=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
project=$(cd -- "$profile/../.." && pwd)
build="$project/build"
rootfs="$build/ultramarine-rootfs"
env="$build/env.img"
p3_image="$profile/board/vendor/sd/p3-kernel-container.img"
boot0="$profile/board/vendor/stock/boot0.img"
boot_package="$profile/board/vendor/sd/boot-package.fex"
seed="$profile/image/layout-6g.seed.sfdisk"
repart="$profile/image/repart.d"
assets="$build/sd-image-assets"
out="$build/ultramarine-trimui-6g.raw"

for input in "$env" "$p3_image" "$boot0" "$boot_package" "$seed"; do
    test -f "$input" || { echo "missing required input: $input" >&2; exit 1; }
done
test -d "$rootfs" || { echo "missing root tree: $rootfs" >&2; exit 1; }

rm -rf "$assets"
mkdir -p "$assets"
test -f "$rootfs/boot/EFI/BOOT/BOOTAA64.EFI" || {
    echo "missing staged systemd-boot ESP" >&2
    exit 1
}

cp -a "$boot0" "$assets/boot0.img"
cp -a "$boot_package" "$assets/boot_package.fex"

rm -f "$out"
truncate -s 6G "$out"
sfdisk "$out" < "$seed" >/dev/null

sudo systemd-repart \
    --offline=no \
    --empty=allow \
    --architecture=arm64 \
    --copy-source="$rootfs" \
    --image="$out" \
    --definitions="$repart" \
    --dry-run=no

# Fixed direct-root starts: p2=1060 MiB, p3=1076 MiB, p4=1172 MiB.
dd if="$env" of="$out" bs=1M seek=1060 conv=notrunc status=none
dd if="$p3_image" of="$out" bs=1M seek=1076 conv=notrunc status=none

# BootROM-visible raw payloads live outside GPT.
dd if="$assets/boot0.img" of="$out" bs=512 seek=256 conv=notrunc status=none
dd if="$assets/boot_package.fex" of="$out" bs=512 seek=32800 conv=notrunc status=none

loop=$(sudo losetup --find --show --partscan "$out")
cleanup() {
    sudo losetup -d "$loop" 2>/dev/null || true
}
trap cleanup EXIT
sudo e2fsck -fn "${loop}p4" >/dev/null
sync
sudo losetup -d "$loop"
trap - EXIT

sfdisk --verify "$out" >/dev/null
cmp -s "$env" <(dd if="$out" bs=512 skip=2170880 count=256 status=none)
cmp -s "$p3_image" <(dd if="$out" bs=512 skip=2203648 count=196608 status=none)
cmp -s "$assets/boot0.img" <(dd if="$out" bs=512 skip=256 count=136 status=none)
cmp -s "$assets/boot_package.fex" <(dd if="$out" bs=512 skip=32800 count=3424 status=none)

rm -rf "$rootfs"

sha256sum "$out"
stat -c '%n %s bytes (apparent)' "$out"
du -h "$out"
