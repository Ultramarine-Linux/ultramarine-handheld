#!/usr/bin/env bash
# Refuse destructive updates unless TARGET is the generated TG5050 disk layout.
set -euo pipefail

target=${1:?usage: validate-target /dev/whole-disk}
test -b "$target" || { echo "not a block device: $target" >&2; exit 1; }
test "$(lsblk -dn -o TYPE "$target")" = disk || {
    echo "target must be a whole disk: $target" >&2
    exit 1
}
test "$(lsblk -dn -o RM "$target")" = 1 || {
    echo "target is not marked removable: $target" >&2
    exit 1
}
case "$target" in
    /dev/*[0-9]) part="${target}p" ;;
    /dev/*) part="$target" ;;
    *) echo "target must be an absolute /dev path" >&2; exit 1 ;;
esac

disk_guid=$(sudo sfdisk -d "$target" | sed -n 's/^label-id: //p')
[[ ${disk_guid,,} == f32f06d7-3d54-4981-a471-304e5b29d17c ]] || {
    echo "unexpected GPT disk GUID on $target: $disk_guid" >&2
    exit 1
}

check_partition() {
    local device=$1 label=$2 uuid=$3 start=$4 size=$5 type=$6
    test -b "$device" || { echo "missing partition: $device" >&2; exit 1; }
    [[ $(lsblk -dn -o PARTLABEL "$device") == "$label" ]] || {
        echo "unexpected label on $device" >&2; exit 1;
    }
    [[ $(lsblk -dn -o PARTTYPE "$device" | tr '[:upper:]' '[:lower:]') == "$type" ]] || {
        echo "unexpected partition type on $device" >&2; exit 1;
    }
    [[ $(lsblk -dn -o PARTUUID "$device" | tr '[:upper:]' '[:lower:]') == "$uuid" ]] || {
        echo "unexpected PARTUUID on $device" >&2; exit 1;
    }
    [[ $(lsblk -dn -o START "$device" | tr -d ' ') == "$start" ]] || {
        echo "unexpected start sector on $device" >&2; exit 1;
    }
    [[ $(lsblk -bdn -o SIZE "$device" | tr -d ' ') == "$size" ]] || {
        echo "unexpected size on $device" >&2; exit 1;
    }
    ! findmnt -rn -S "$device" >/dev/null || {
        echo "target partition is mounted: $device" >&2; exit 1;
    }
}

check_partition "${part}1" EFI-SYSTEM 2f8a6891-7e8a-49af-b3b9-e5249519cfe7 2048 1073741824 c12a7328-f81f-11d2-ba4b-00a0c93ec93b
check_partition "${part}2" boot-resource 5de82070-7b8c-4337-bb93-cae98c396718 2099200 100663296 ebd0a0a2-b9e5-4433-87c0-68b6b72699c7
check_partition "${part}3" rootfs 693b9aba-2fc7-4222-9bd9-d2dc7b82099a 2295808 5153964032 b921b045-1df0-41c3-af44-4c6f280d3fae

printf '%s\n' "$part"
