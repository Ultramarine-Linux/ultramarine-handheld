#!/usr/bin/env bash
# Extract the packaged TG5050 kernel payload for boot-tree staging.
set -euo pipefail

rpm_dir=$(realpath "${1:?usage: stage-kernel-rpm <rpm-dir> <output-dir>}")
out=$(realpath -m "${2:?usage: stage-kernel-rpm <rpm-dir> <output-dir>}")
mapfile -t rpms < <(find "$rpm_dir" -type f \( \
    -name 'kernel-tg5050-*.aarch64.rpm' -o \
    -name 'kernel-tg5050-core-*.aarch64.rpm' -o \
    -name 'kernel-tg5050-modules-*.aarch64.rpm' \
\) -print)
for package in kernel-tg5050 kernel-tg5050-core kernel-tg5050-modules; do
    count=0
    for rpm in "${rpms[@]}"; do
        case "/$rpm" in
            *"/$package-"*.aarch64.rpm) count=$((count + 1)); source_rpm=$rpm ;;
        esac
    done
    (( count == 1 )) || { echo "expected one $package RPM, found $count" >&2; exit 1; }
    mkdir -p "$out"
    rpm2cpio "$source_rpm" | cpio --extract --directory="$out" --make-directories --quiet
done

mapfile -t kernels < <(find "$out/boot" -maxdepth 1 -type f -name 'vmlinuz-*' -print)
(( ${#kernels[@]} == 1 )) || { echo "expected one packaged kernel image" >&2; exit 1; }
mapfile -t releases < <(find "$out/usr/lib/modules" -mindepth 1 -maxdepth 1 -type d -printf '%f\n')
(( ${#releases[@]} == 1 )) || { echo "expected one packaged kernel release" >&2; exit 1; }
printf 'staged packaged kernel %s (%s) in %s\n' "${kernels[0]}" "${releases[0]}" "$out"
