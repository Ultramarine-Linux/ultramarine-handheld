From 6b4d1a0f8f4d7f58c9d8e4f7a8c5d1e2f3a4b5c6 Mon Sep 17 00:00:00 2001
From: Cappy Ishihara <cappy@cappuchino.xyz>
Date: Tue, 8 Sep 2026 00:00:00 +0000
Subject: [PATCH] arm64: dts: tg5050: force USB-C port into gadget mode

The TG5050 USB-C port is used as the device-side gadget/debug connection in
this production image. The Type-C role-switch path currently selects host mode
on boot and leaves no usable UDC for the host PC. Keep the dedicated USB host
controllers separate and make this OTG port a peripheral-only gadget port.

Signed-off-by: Cappy Ishihara <cappy@cappuchino.xyz>
---
 arch/arm64/boot/dts/allwinner/sun55i-a523-trimui-smart-pro-s.dts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun55i-a523-trimui-smart-pro-s.dts b/arch/arm64/boot/dts/allwinner/sun55i-a523-trimui-smart-pro-s.dts
index cd8a92a..c239fe1 100644
--- a/arch/arm64/boot/dts/allwinner/sun55i-a523-trimui-smart-pro-s.dts
+++ b/arch/arm64/boot/dts/allwinner/sun55i-a523-trimui-smart-pro-s.dts
@@ -514,8 +514,8 @@
 
 /* USB */
 &usb_otg {
-	dr_mode = "otg";	/* external "usb/dp" USB-C port */
-	usb-role-switch;	/* host/device role driven by the husb311 Type-C PD controller */
+	dr_mode = "peripheral";	/* external "usb/dp" USB-C gadget port */
+	/delete-property/ usb-role-switch;	/* keep MUSB in device mode for gadget access */
 	status = "okay";
 
 	port {
-- 
2.51.0
