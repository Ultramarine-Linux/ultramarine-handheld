From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cappy Ishihara <cappy@cappuchino.xyz>
Date: Sat, 12 Sep 2026 00:00:00 +0700
Subject: [PATCH] drm: sun4i: follow BSP TCON-to-DSI open ordering

Defer DSI video start until after the DRM DE engine commit, matching the
BSP's TCON DCLK/LCD enable before DSI HSD ordering. The BSP configures the
CPU trigger enable in tcon_dsi_cfg(); it does not issue a separate trigger
start from the DRM atomic-flush path.

Signed-off-by: Cappy Ishihara <cappy@cappuchino.xyz>

---
--- a/drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c
+++ b/drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c
@@ -795,10 +795,15 @@
 	if (dsi->panel)
 		drm_panel_enable(dsi->panel);
 
-	dev_info(dsi->dev, "A523 CPU trigger: DSI panel enabled, starting HSC\n");
+	/* Video start is deferred until TCON and the DE commit are complete. */
+}
+
+void sun6i_dsi_start_video(struct sun6i_dsi *dsi)
+{
+	dev_info(dsi->dev, "A523 BSP order: start DSI HSC/HSD\n");
 	sun6i_dsi_start(dsi, DSI_START_HSC);
-	dev_info(dsi->dev, "A523 CPU trigger: DSI enable exit\n");
-}
+}
+EXPORT_SYMBOL(sun6i_dsi_start_video);
 
 static void sun6i_dsi_encoder_disable(struct drm_encoder *encoder)
 {
--- a/drivers/gpu/drm/sun4i/sun6i_mipi_dsi.h
+++ b/drivers/gpu/drm/sun4i/sun6i_mipi_dsi.h
@@ -50,6 +50,8 @@
 	return container_of(connector, struct sun6i_dsi, connector);
 };
 
+void sun6i_dsi_start_video(struct sun6i_dsi *dsi);
+
 static inline struct sun6i_dsi *encoder_to_sun6i_dsi(const struct drm_encoder *encoder)
 {
 	return container_of(encoder, struct sun6i_dsi, encoder);
--- a/drivers/gpu/drm/sun4i/sun4i_crtc.c
+++ b/drivers/gpu/drm/sun4i/sun4i_crtc.c
@@ -25,12 +25,13 @@
 
 #include "sun4i_backend.h"
 #include "sun4i_crtc.h"
 #include "sun4i_drv.h"
 #include "sunxi_engine.h"
 #include "sun4i_tcon.h"
+#include "sun6i_mipi_dsi.h"
 
 /*
  * While this isn't really working in the DRM theory, in practice we
  * can only ever have one encoder per TCON since we have a mux in our
  * TCON.
  */
@@ -85,16 +86,21 @@
 
 static void sun4i_crtc_atomic_flush(struct drm_crtc *crtc,
 				    struct drm_atomic_commit *state)
 {
 	struct sun4i_crtc *scrtc = drm_crtc_to_sun4i_crtc(crtc);
 	struct drm_pending_vblank_event *event = crtc->state->event;
+	struct drm_encoder *encoder;
 
 	DRM_DEBUG_DRIVER("Committing plane changes\n");
 
 	sunxi_engine_commit(scrtc->engine, crtc, state);
+	encoder = sun4i_crtc_get_encoder(crtc);
+	if (encoder && encoder->encoder_type == DRM_MODE_ENCODER_DSI) {
+		sun6i_dsi_start_video(encoder_to_sun6i_dsi(encoder));
+	}
 
 	if (event) {
 		crtc->state->event = NULL;
 
 		spin_lock_irq(&crtc->dev->event_lock);
 		if (drm_crtc_vblank_get(crtc) == 0)
 
