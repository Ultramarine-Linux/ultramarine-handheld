+/*
+ * v35x RCQ: the sun55i_de backend only stages (for now) the primary UI
+ * channel. Registering the VI/overlay planes without staging them was
+ * worse than not having them: the compositor uses them (kwin puts the
+ * cursor there), its legacy atomic_update overwrote live blender
+ * registers and the plane was not even visible. With only the primary,
+ * compositors compose the cursor in software (visible). The other
+ * channels will come with real multi-plane.
+ */
+static struct drm_plane **sun55i_layers_init(struct drm_device *drm,
+					     struct sunxi_engine *engine)
+{
+	struct sun8i_mixer *mixer = engine_to_sun8i_mixer(engine);
+	struct drm_plane **planes;
+	struct sun8i_layer *layer;
+
+	planes = devm_kcalloc(drm->dev, 2, sizeof(*planes), GFP_KERNEL);
+	if (!planes)
+		return ERR_PTR(-ENOMEM);
+
+	layer = sun8i_ui_layer_init_one(drm, DRM_PLANE_TYPE_PRIMARY,
+					mixer->engine.regs, 1, 6, 1,
+					&mixer->cfg->lay_cfg);
+	if (IS_ERR(layer)) {
+		dev_err(drm->dev, "Couldn't initialize primary plane\n");
+		return ERR_CAST(layer);
+	}
+	planes[0] = &layer->plane;
+
+	return planes;
