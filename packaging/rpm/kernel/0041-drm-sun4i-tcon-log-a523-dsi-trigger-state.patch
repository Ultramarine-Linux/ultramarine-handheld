From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cappy Ishihara <cappy@cappuchino.xyz>
Date: Wed, 9 Sep 2026 00:00:00 +0000
Subject: [PATCH] drm: sun4i: log A523 DSI trigger state during enable

Capture the TCON CPU-interface trigger registers after modeset.  This is
intentionally diagnostic: the A523 display stream currently reaches the
panel and DSI setup but never produces vblank.

---
 drivers/gpu/drm/sun4i/sun4i_tcon.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/drivers/gpu/drm/sun4i/sun4i_tcon.c b/drivers/gpu/drm/sun4i/sun4i_tcon.c
index 000000000000..111111111111 100644
--- a/drivers/gpu/drm/sun4i/sun4i_tcon.c
+++ b/drivers/gpu/drm/sun4i/sun4i_tcon.c
@@ -478,6 +478,17 @@ static void sun4i_tcon0_mode_set_cpu(struct sun4i_tcon *tcon,
 	regmap_write(tcon->regs, SUN4I_TCON_SAFE_PERIOD_REG,
 		     SUN4I_TCON_SAFE_PERIOD_NUM(3000) |
 		     SUN4I_TCON_SAFE_PERIOD_MODE(3));
+
+	if (tcon->quirks->has_channel_0) {
+		u32 cpu_if, tri0, tri1, tri2;
+
+		regmap_read(tcon->regs, SUN4I_TCON0_CPU_IF_REG, &cpu_if);
+		regmap_read(tcon->regs, SUN4I_TCON0_CPU_TRI0_REG, &tri0);
+		regmap_read(tcon->regs, SUN4I_TCON0_CPU_TRI1_REG, &tri1);
+		regmap_read(tcon->regs, SUN4I_TCON0_CPU_TRI2_REG, &tri2);
+		dev_info(tcon->dev, "DSI trigger cpu_if=%#x tri0=%#x tri1=%#x tri2=%#x\n",
+			 cpu_if, tri0, tri1, tri2);
+	}
 
 	/* Enable the output on the pins */
 	regmap_write(tcon->regs, SUN4I_TCON0_IO_TRI_REG,
-- 
2.47.0
