From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cappy Ishihara <cappy@cappuchino.xyz>
Date: Sat, 12 Sep 2026 00:00:00 +0700
Subject: [PATCH] drm: sun8i: implement A523 VCH0 RGB contract

The A523 BSP's working primary path is DE350 VCH0.  Its video overlay uses
ARGB8888 hardware format 0, global alpha mode 1, RGB selection, and global
alpha 0xff for the opaque framebuffer.  The generic DE33 path currently
emits XRGB8888 format 4 with pixel-alpha mode, producing 0xff008401 instead
of the BSP's 0xff008003.

The BSP also enables the VCH0 channel CSC at DE + 0x100800 and loads its
RGB-to-RGB identity matrix before enabling it.  Apply that contract only to
the A523 VCH0 configuration; leave other DE33 variants and YUV CSC handling
unchanged.

Signed-off-by: Cappy Ishihara <cappy@cappuchino.xyz>

---
 drivers/gpu/drm/sun4i/sun8i_csc.c      | 25 +++++++++++++++++++++++++
 drivers/gpu/drm/sun4i/sun8i_mixer.c    |  1 +
 drivers/gpu/drm/sun4i/sun8i_mixer.h    |  1 +
 drivers/gpu/drm/sun4i/sun8i_vi_layer.c | 14 +++++++++++++-
 4 files changed, 40 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/sun4i/sun8i_mixer.h b/drivers/gpu/drm/sun4i/sun8i_mixer.h
--- a/drivers/gpu/drm/sun4i/sun8i_mixer.h
+++ b/drivers/gpu/drm/sun4i/sun8i_mixer.h
@@ -180,6 +180,7 @@
 	unsigned int	vi_scaler_num;
 	int		scaler_mask;
 	int		ccsc;
+	unsigned int	a523_vch0;
 	unsigned int	de_type;
 	unsigned int	scanline_yuv;
 	unsigned int	de2_fcc_alpha : 1;

diff --git a/drivers/gpu/drm/sun4i/sun8i_mixer.c b/drivers/gpu/drm/sun4i/sun8i_mixer.c
--- a/drivers/gpu/drm/sun4i/sun8i_mixer.c
+++ b/drivers/gpu/drm/sun4i/sun8i_mixer.c
@@ -888,6 +888,7 @@
 		.de_type	= SUN8I_MIXER_DE33,
 		.scaler_mask	= 0x3f,
 		.scanline_yuv	= 4096,
+		.a523_vch0	= 1,
 	},
 	.de_type	= SUN8I_MIXER_DE33,
 	.mod_rate	= 600000000,

diff --git a/drivers/gpu/drm/sun4i/sun8i_vi_layer.c b/drivers/gpu/drm/sun4i/sun8i_vi_layer.c
--- a/drivers/gpu/drm/sun4i/sun8i_vi_layer.c
+++ b/drivers/gpu/drm/sun4i/sun8i_vi_layer.c
@@ -38,12 +38,19 @@
 	ch_base = sun8i_channel_base(layer);
 	fmt = state->fb->format;
 	sun8i_mixer_drm_format_to_hw(fmt->format, &hw_fmt);
+	if (layer->cfg->a523_vch0 && layer->channel == 0 &&
+	    fmt->format == DRM_FORMAT_XRGB8888)
+		hw_fmt = SUN8I_MIXER_FBFMT_ARGB8888;
 
 	val = hw_fmt << SUN8I_MIXER_CHAN_VI_LAYER_ATTR_FBFMT_OFFSET;
 	if (!fmt->is_yuv)
 		val |= SUN8I_MIXER_CHAN_VI_LAYER_ATTR_RGB_MODE;
 	val |= SUN8I_MIXER_CHAN_VI_LAYER_ATTR_EN;
-	if (layer->cfg->de_type >= SUN8I_MIXER_DE3) {
+	if (layer->cfg->a523_vch0 && layer->channel == 0 &&
+	    state->alpha == DRM_BLEND_ALPHA_OPAQUE) {
+		val |= SUN50I_MIXER_CHAN_VI_LAYER_ATTR_ALPHA(state->alpha >> 8);
+		val |= SUN50I_MIXER_CHAN_VI_LAYER_ATTR_ALPHA_MODE_LAYER;
+	} else if (layer->cfg->de_type >= SUN8I_MIXER_DE3) {
 		val |= SUN50I_MIXER_CHAN_VI_LAYER_ATTR_ALPHA(state->alpha >> 8);
 		val |= (state->alpha == DRM_BLEND_ALPHA_OPAQUE) ?
 			SUN50I_MIXER_CHAN_VI_LAYER_ATTR_ALPHA_MODE_PIXEL :
 			SUN50I_MIXER_CHAN_VI_LAYER_ATTR_ALPHA_MODE_COMBINED;

diff --git a/drivers/gpu/drm/sun4i/sun8i_csc.c b/drivers/gpu/drm/sun4i/sun8i_csc.c
--- a/drivers/gpu/drm/sun4i/sun8i_csc.c
+++ b/drivers/gpu/drm/sun4i/sun8i_csc.c
@@ -227,11 +227,36 @@
 	}
 }
 
+static void sun8i_a523_vch0_csc_setup(struct regmap *map, u32 ch_base)
+{
+	static const u32 identity[] = {
+		0x00020000, 0, 0, 0,
+		0, 0x00020000, 0, 0,
+		0, 0, 0x00020000, 0,
+	};
+	u32 base = ch_base + 0x800;
+	int i;
+
+	/* BSP de35x RGB->RGB VCH0 CSC: identity matrix, then enable. */
+	regmap_write(map, base + 0x4, 0);
+	regmap_write(map, base + 0x8, 0);
+	regmap_write(map, base + 0xc, 0);
+	for (i = 0; i < ARRAY_SIZE(identity); i++)
+		regmap_write(map, base + 0x10 + i * 4, identity[i]);
+	regmap_write(map, base + 0x0, 1);
+}
+
 void sun8i_csc_config(struct sun8i_layer *layer,
 		      struct drm_plane_state *state)
 {
 	u32 mode = sun8i_csc_get_mode(state);
 	u32 base;
+
+	if (layer->cfg->a523_vch0 && layer->channel == 0 &&
+	    state->fb && !state->fb->format->is_yuv) {
+		sun8i_a523_vch0_csc_setup(layer->regs, sun8i_channel_base(layer));
+		return;
+	}
 
 	if (layer->cfg->de_type == SUN8I_MIXER_DE3) {
 		sun8i_de3_ccsc_setup(layer->regs, layer->channel,
-- 
