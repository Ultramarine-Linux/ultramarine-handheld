# Boot-critical TG5050 display path.
#
# The early TG5050 image does not load DRM/PWM modules before userspace. Keep the
# complete panel path built in so the DSI host can probe and pwm-backlight can
# establish a visible backlight during first bring-up.
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN6I_DSI=y
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_DRM_SUN8I_TCON_TOP=y
CONFIG_PHY_SUN6I_MIPI_DPHY=y
CONFIG_PHY_SUN55I_DSI_COMBO=y
# Keep the panel driver built in so it is registered before the sun4i component
# master probes; late module registration causes missing-panel modesets and
# vblank/flip timeouts during first bring-up.
CONFIG_DRM_PANEL_TRIMUI_SMART_PRO_S=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM_SUN20I=y
