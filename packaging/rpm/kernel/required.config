# Boot-critical TG5050 platform dependencies missing from clean arm64 defconfig.
CONFIG_I2C_MV64XXX=y
CONFIG_MFD_AXP20X=y
CONFIG_MFD_AXP20X_I2C=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_AXP20X=y
CONFIG_RTC_DRV_SUN6I=y
CONFIG_SERIAL_8250_DW=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
# The root filesystem is on the A523 microSD; keep the complete MMC path
# built into the kernel so EFI/systemd-boot can mount p3 without module initrd
# ordering races.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SUNXI=y
# AIC8800 out-of-tree SDIO Wi-Fi/Bluetooth build dependencies.
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
