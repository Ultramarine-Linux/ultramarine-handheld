From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cappy Ishihara <cappy@cappuchino.xyz>
Date: Sat, 12 Sep 2026 00:00:00 +0700
Subject: [PATCH] drm: sun8i: a523: use BSP VCH0 primary path

The A523 BSP uses VCH0 as the primary framebuffer path and routes blender pipe
0 to channel 0. Represent that topology through the existing DE33 mixer
configuration without changing the formatter or module clock rate.

Signed-off-by: Cappy Ishihara <cappy@cappuchino.xyz>

---
 drivers/gpu/drm/sun4i/sun8i_mixer.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

--- a/drivers/gpu/drm/sun4i/sun8i_mixer.c
+++ b/drivers/gpu/drm/sun4i/sun8i_mixer.c
@@ -880,9 +880,8 @@
 };
 
 /*
- * A523 (sun55iw3) DE3.5 - DE33-class. 6 channels = 3 VI + 3 UI (BSP de350).
- * map[] from BSP chn_id_lut {0,1,2 video, 6,7,8 ui}. scaler_mask/mod_rate
- * VERIFY on hardware.
+ * A523 (sun55iw3) DE3.5 - DE33-class. The BSP uses VCH0 as the primary
+ * framebuffer path and routes blender pipe 0 to channel 0.
  */
 static const struct sun8i_mixer_cfg sun55i_a523_mixer0_cfg = {
 	.lay_cfg = {
@@ -892,9 +891,9 @@
 	},
 	.de_type	= SUN8I_MIXER_DE33,
 	.mod_rate	= 600000000,
-	.ui_num		= 3,
 	.vi_num		= 3,
-	.map		= {0, 1, 2, 6, 7, 8},
+	.ui_num		= 0,
+	.map		= {0, 1, 2},
 };
 
 static const struct of_device_id sun8i_mixer_of_table[] = {
-- 
2.43.0
