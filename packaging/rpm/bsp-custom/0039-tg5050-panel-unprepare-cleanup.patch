From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cappy Ishihara <cappy@fyralabs.com>
Date: Sat, 19 Sep 2026 00:00:00 +0000
Subject: [PATCH] drm: panel-dsi: always complete physical unprepare cleanup

A failed DCS display-off or enter-sleep command previously returned from
unprepare before GPIO, reset, and regulator teardown. If the panel was
already in a bad state, this left the external DDIC powered and latched
while the DSI PHY was subsequently powered down. The next output enable,
suspend resume, or warm U-Boot handoff could then fail until full power was
removed.

Record the first DCS error but always complete the physical teardown, and
return the error only after the panel has been reset and powered down.

--- a/drivers/drm/panel/panel-dsi.c
+++ b/drivers/drm/panel/panel-dsi.c
@@ -262,7 +262,7 @@
 {
 	struct panel_dsi *dsi_panel = to_panel_dsi(panel);
 	struct gpio_timing *timing;
-	int i, items, ret;
+	int i, items, ret, err = 0;
 
 	if (dsi_panel->desc->exit_seq)
 		if (dsi_panel->dsi)
@@ -272,14 +272,14 @@
 		ret = mipi_dsi_dcs_set_display_off(dsi_panel->dsi);
 		if (ret < 0) {
 			dev_err(dsi_panel->dev, "Failed to set display off: %d\n", ret);
-			return ret;
+			err = ret;
 		}
 		msleep(20);
 
 		ret = mipi_dsi_dcs_enter_sleep_mode(dsi_panel->dsi);
 		if (ret < 0) {
 			dev_err(dsi_panel->dev, "Failed to enter sleep mode: %d\n", ret);
-			return ret;
+			err = ret;
 		}
 		msleep(120);
 	}
@@ -327,7 +327,7 @@
 		}
 	}
 
-	return 0;
+	return err;
 }
 
 int panel_dsi_regulator_enable(struct drm_panel *panel)
