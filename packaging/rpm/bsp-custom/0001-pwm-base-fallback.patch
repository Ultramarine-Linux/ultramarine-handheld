diff --git a/drivers/pwm/pwm-sunxi.c b/drivers/pwm/pwm-sunxi.c
index 7e4eba7..ec1091b 100644
--- a/drivers/pwm/pwm-sunxi.c
+++ b/drivers/pwm/pwm-sunxi.c
@@ -2051,6 +2051,7 @@ static int sunxi_pwm_resource_get(struct platform_device *pdev,
 	const char *st = NULL;
 	struct platform_device *pwm_pdevice;
 	struct device_node *sub_np;
+	u32 pwm_base;
 
 	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
 	if (!res) {
@@ -2066,8 +2067,14 @@ static int sunxi_pwm_resource_get(struct platform_device *pdev,
 
 	chip->pwm_num = of_alias_get_id(np, "pwm");
 	if (chip->pwm_num < 0) {
