#!/bin/sh
set -eu

mkdir -p /var/tmp/sources /var/tmp/rpmbuild /work/out
cp src/rpm/firmware/stock-firmware.sha256 src/rpm/firmware/README.md /var/tmp/sources/
spectool -g -C /var/tmp/sources src/rpm/firmware/aic8800-firmware.spec

rpmbuild -bb \
    --define '_topdir /var/tmp/rpmbuild' \
    --define '_sourcedir /var/tmp/sources' \
    --define "_rpmdir $PACKAGEDIR" \
    --define '_build_name_fmt %{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}.rpm' \
    --define '_binary_payload w3T.xzdio' \
    src/rpm/firmware/aic8800-firmware.spec

