#!/usr/bin/env bash
# Build a minimal Android boot-image v0 for p3.
# Retains the extracted vendor kernel and original Android header layout while
# replacing Knulli's embedded ramdisk with a controlled p4 handoff.
set -euo pipefail

project=$(cd "$(dirname "$0")/.." && pwd)
build="$project/build"
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT

vendor_kernel="$project/board/trimui-smart-pro-s/boot-artifacts/vendor-kernel-5.15.147.Image"
vendor_ramdisk="$project/board/trimui-smart-pro-s/boot-artifacts/vendor-p3-ramdisk.cpio.gz"
output="$build/ultramarine-p3.img"

for file in "$vendor_kernel" "$vendor_ramdisk" "$project/p3/root/init"; do
    test -f "$file" || { printf 'missing required input: %s\n' "$file" >&2; exit 1; }
done

# Preserve the complete vendor ramdisk payload (healthd, minui, runtime
# libraries, modules, and vendor utilities). Only /init is replaced, removing
# Knulli's rootfs-detection logic while retaining charger-mode capabilities.
mkdir -p "$stage/root"
gzip -dc "$vendor_ramdisk" | cpio -idmu --no-absolute-filenames -D "$stage/root" --quiet
install -m 0755 "$project/p3/root/init" "$stage/root/init"

(
    cd "$stage/root"
    find . -print0 | cpio --null -o -H newc --quiet | gzip -n >"$stage/ramdisk.cpio.gz"
)

mkbootimg \
    --kernel "$vendor_kernel" \
    --ramdisk "$stage/ramdisk.cpio.gz" \
    --header_version 0 \
    --pagesize 2048 \
    --base 0x40000000 \
    --kernel_offset 0x00080000 \
    --ramdisk_offset 0x02000000 \
    --second_offset 0x00f00000 \
    --tags_offset 0x00000100 \
    --board sun55i_arm64 \
    --output "$stage/boot.img"

# mkbootimg clears second_addr when no second-stage payload is supplied, while
# the vendor v0 header retains 0x40f00000 with second_size=0. Preserve that
# inert metadata so the header layout matches the known-good carrier.
python3 - "$stage/boot.img" <<'PY'
import struct
import sys
path = sys.argv[1]
with open(path, 'r+b') as f:
    f.seek(28)  # Android boot image v0: second_addr
    f.write(struct.pack('<I', 0x40f00000))
PY

# p3 is a fixed 96 MiB raw GPT partition.
truncate -s 96M "$output"
dd if="$stage/boot.img" of="$output" conv=notrunc status=none

printf 'p3 image: %s\n' "$output"
printf 'ramdisk:  %s bytes\n' "$(stat -c %s "$stage/ramdisk.cpio.gz")"
printf 'image:    %s bytes\n' "$(stat -c %s "$output")"
sha256sum "$output"
