#!/usr/bin/env bash
# Build a compact 6 GiB TrimUI Smart Pro S SD image.
#
# GPT p1-p5 are created by systemd-repart after a seed GPT reserves the raw
# Allwinner boot region. boot0/SPL and boot_package remain fixed raw slots.
set -euo pipefail

project=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
build="$project/build"
rootfs="$build/ultramarine-rootfs.ext4"
env="$build/env-direct-root.img"
vendor_boot="$project/board/trimui-smart-pro-s/partitions/vendor-boot.img"
p4_image="$build/ramdisk-p4.img"
boot0="$project/board/trimui-smart-pro-s/partitions/boot0.img"
boot_package="$project/board/trimui-smart-pro-s/partitions/boot_package.fex"
seed="$project/image/layout-6g.seed.sfdisk"
repart="$project/image/repart.d"
assets="$build/sd-image-assets"
out="$build/ultramarine-trimui-6g.raw"

for input in "$rootfs" "$env" "$vendor_boot" "$p4_image" "$boot0" "$boot_package" "$seed"; do
    test -e "$input" || { echo "missing required input: $input" >&2; exit 1; }
done

rm -rf "$assets"
mkdir -p "$assets/p1-minimal/boot"

# Keep vendor/update assets while intentionally omitting the 1.9 GiB Knulli
# SquashFS. The complete board-owned source tree is retained for recovery
# image profiles.
p1_template="$project/board/trimui-smart-pro-s/boot-resource"
for path in adjtime.data bat bootlogo.bmp knulli-boot.conf partitions; do
    cp -a "$p1_template/$path" "$assets/p1-minimal/"
done
for path in autoresize firmware.sig knulli.board knulli.board.capability; do
    cp -a "$p1_template/boot/$path" "$assets/p1-minimal/boot/"
done

# p4 is a raw ext4 bootstrap root, block-copied after repart creates its slot.
# It deliberately uses the legacy-compatible ext4 features checked above.

# First-class fixed raw boot artifacts, sourced from the board tree.
cp -a "$boot0" "$assets/boot0.img"
cp -a "$boot_package" "$assets/boot_package.fex"

# The image remains sparse until populated; its apparent size is 6 GiB.
rm -f "$out"
truncate -s 6G "$out"
sfdisk "$out" < "$seed" >/dev/null

# p5 is preseeded before repart so systemd-repart can discover an ARM64 root.
# p5 starts at exactly 1684 MiB in this compact layout.
dd if="$rootfs" of="$out" bs=1M seek=1684 conv=notrunc status=none

sudo systemd-repart \
    --offline=no \
    --empty=allow \
    --architecture=arm64 \
    --copy-source="$assets" \
    --image="$out" \
    --definitions="$repart" \
    --dry-run=no

# Repart creates blank raw p2/p3/p4 slots; install their known-good payloads.
# Starts are exact MiB boundaries: p2=1060, p3=1076, p4=1172 MiB.
dd if="$env" of="$out" bs=1M seek=1060 conv=notrunc status=none
dd if="$vendor_boot" of="$out" bs=1M seek=1076 conv=notrunc status=none
dd if="$p4_image" of="$out" bs=1M seek=1172 conv=notrunc status=none

# Allwinner ROM-visible raw regions, outside GPT partitions.
dd if="$assets/boot0.img" of="$out" bs=512 seek=256 conv=notrunc status=none
dd if="$assets/boot_package.fex" of="$out" bs=512 seek=32800 conv=notrunc status=none

# Grow the prebuilt 2 GiB p5 filesystem to the compact image's 4.355 GiB p5.
# Normalize p4 ownership after mkosi's rootless build so PID 1's bootstrap
# filesystem is genuinely root-owned, not host UID 1000-owned.
loop=$(sudo losetup --find --show --partscan "$out")
m4=$(mktemp -d)
cleanup() {
    sudo umount "$m4" 2>/dev/null || true
    rmdir "$m4" 2>/dev/null || true
    sudo losetup -d "$loop" 2>/dev/null || true
}
trap cleanup EXIT
sudo e2fsck -fy "${loop}p5" >/dev/null
sudo resize2fs "${loop}p5" >/dev/null
sudo e2fsck -fn "${loop}p5" >/dev/null
sudo mount "${loop}p4" "$m4"
sudo chown -hR root:root "$m4"
sync
sudo umount "$m4"
rmdir "$m4"
sudo losetup -d "$loop"
trap - EXIT

# Structural checks: GPT, fixed raw slots, p2/p3 byte identity, and p4
# filesystem integrity (p4 ownership is deliberately normalized above).
sfdisk --verify "$out" >/dev/null
cmp -s "$env" <(dd if="$out" bs=512 skip=2170880 count=256 status=none)
cmp -s "$vendor_boot" <(dd if="$out" bs=512 skip=2203648 count=196608 status=none)
cmp -s "$assets/boot0.img" <(dd if="$out" bs=512 skip=256 count=136 status=none)
cmp -s "$assets/boot_package.fex" <(dd if="$out" bs=512 skip=32800 count=3424 status=none)

sha256sum "$out"
stat -c '%n %s bytes (apparent)' "$out"
du -h "$out"
